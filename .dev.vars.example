# Copy to .dev.vars for local Wrangler/Vite development. Never commit .dev.vars.
# Leave all values empty to enable the local-only synthetic demo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate 32 random bytes as 64 lowercase hex characters.
ONTRACK_SESSION_SECRET=
# Exactly one approved Google email; keep it in secrets, not in this template.
ONTRACK_GOOGLE_EMAIL=
# Local example: http://127.0.0.1:5173
ONTRACK_ORIGIN=
ONTRACK_SCRIPT_URL=
ONTRACK_API_TOKEN=
ONESIGNAL_APP_ID=
